# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*

# Local environments
.venv/
venv/
env/

# Build artifacts
build/
dist/
*.egg-info/
node_modules/

# Vite builds the Web bundle into the package. It is never committed; the
# release workflow builds it before packaging.
src/lh_harness/_frontend/
# Build identity written by the deploy build job (src/lh_harness/build_info.py).
src/lh_harness/_build_info.json

# package-lock.json is the authority used by CI; bun may be used locally but
# its lockfile is not committed so the two cannot drift.
bun.lock
bun.lockb

# Local run outputs
.lh-harness/
runs/
logs/
results/
tmp/

# Secrets and local overrides
.env
*.env
env.local.sh
*.local.sh
*.mcp.json

# Editor/system
.DS_Store
.idea/
.vscode/
.lh-harness-quickstart/

# Hook/runtime logs
*.log

# kb hook log now lives in ~/.claude; ignore any legacy in-repo copy
kb-article/kb-hook.log
