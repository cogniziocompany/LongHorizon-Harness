#!/usr/bin/env bash
# ct110-overseer-sweep-secrets.env — EXAMPLE ONLY, ship nothing but NAMES.
#
# This is the operator template for /home/harness/.overseer-sweep-secrets.env
# on CT110 (the EnvironmentFile of lh-overseer-sweep.service).  Copy it to the
# host and fill in the VALUES there; the values must NEVER be committed.  The
# NAME registry lives in docs/SECRETS.md; the mode/rollout rules live in
# docs/OVERSEER-TICK-CT110.md.
#
# Every entry below is intentionally EMPTY.  An empty mandatory credential
# makes the tick degrade loudly (see scripts/overseer_ct110/README.md),
# never silently.

# --- headless claude credential (harness ANTHROPIC_* names) -----------------
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# --- GitHub (gh CLI) ---------------------------------------------------------
GH_TOKEN=

# --- CT110 harness API -------------------------------------------------------
LH_HARNESS_WEB_TOKEN=
# CT110_WEB_URL defaults to http://192.168.21.168:8799 (non-secret topology,
# same class as the archived scripts' endpoints; see docs/SECRETS.md).

# --- LiteLLM gateway MCP wiring (names only; the `ssh` MCP server is
#     reached through this key under its alias `ssh`) ------------------------
LH_HARNESS_MCP_GATEWAY_URL=
LH_HARNESS_MCP_GATEWAY_KEY=
LH_HARNESS_MCP_GATEWAY_HEADERS_JSON=

# --- Seq logging (TASK 161 contract; unset SEQ_URL disables the sink) ------
SEQ_URL=
SEQ_API_KEY=
SEQ_MIN_LEVEL=

# --- hivemind ingest (TASK 229 contract; unset both disables the ingest) ---
MEMORY_URL=
MEMORY_TOKEN=
MEMORY_MCP_URL=
MEMORY_MCP_KEY=
MEMORY_MCP_TOOL=

# --- mode flags (task 236) ---------------------------------------------------
# LH_OVERSEER_TICK_MODE is set in lh-overseer-sweep.service (read-only
# default).  Acting mode REQUIRES both of the following in this env file —
# and requires the PTAIT09 `LH-Overseer-Sweep` scheduled task to be disabled
# first (never both acting at once):
#   LH_OVERSEER_TICK_MODE=act
#   LH_OVERSEER_TICK_ACT_CONFIRM=YES